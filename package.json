{
  "name": "warptoad-v1",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "size": "hardhat compile && node scripts/size.ts",
    "noir:compile": "cd circuits && nargo compile",
    "noir:test": "cd circuits && nargo test",
    "noir:gates": "cd circuits && bb gates -b ./target/warptoad_v1.json",
    "noir:vk": "cd circuits && bb write_vk -b ./target/warptoad_v1.json -o ./target -t evm",
    "noir:verifier": "cd circuits && bb write_solidity_verifier -k ./target/vk -o ./target/Verifier.sol -t evm --optimized",
    "noir:cp-verifier": "cp circuits/target/Verifier.sol contracts/WarptoadVerifier.sol",
    "noir:rename-verifier": "sed -i 's/^contract HonkVerifier is/contract WarptoadVerifier is/' contracts/WarptoadVerifier.sol",
    "noir": "pnpm noir:compile && pnpm noir:vk && pnpm noir:verifier && pnpm noir:cp-verifier && pnpm noir:rename-verifier"
  },
  "devDependencies": {
    "@aztec/bb.js": "5.0.0-nightly.20260525",
    "@noir-lang/noir_js": "1.0.0-beta.22",
    "@nomicfoundation/hardhat-ignition": "^3.1.8",
    "@nomicfoundation/hardhat-toolbox-viem": "^5.0.7",
    "@types/node": "^22.8.5",
    "@zk-kit/eddsa-poseidon": "1.1.0",
    "forge-std": "github:foundry-rs/forge-std#v1.9.4",
    "hardhat": "^3.14.0",
    "typescript": "~6.0.3",
    "viem": "^2.55.19"
  },
  "dependencies": {
    "@nomicfoundation/hardhat-viem": "^3.0.9",
    "@openzeppelin/contracts": "^5.6.1",
    "@warptoad/skinny-fat-imt-js": "0.0.8",
    "@warptoad/skinny-imt.sol": "0.0.11",
    "@zkpassport/poseidon2": "0.6.2",
    "poseidon2-evm": "^2.0.0"
  }
}